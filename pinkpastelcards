<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pastel Flashcards 💕</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --pink-50: #fff0f5;
    --pink-100: #ffe4ec;
    --pink-200: #ffc2d4;
    --pink-300: #ff9ebb;
    --pink-400: #ff7aa2;
    --pink-500: #ff5c8a;
    --lavender: #f5d6e8;       /* softer pink-lavender */
    --lavender-dark: #ebc4d8;
    --cream: #fff9f5;
    --text: #5a3d4a;
    --text-soft: #8a6a75;
    --white: #ffffff;
    --shadow: 0 8px 24px rgba(255, 122, 162, 0.18);
    --shadow-soft: 0 4px 12px rgba(255, 122, 162, 0.12);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Quicksand', -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Yu Gothic", "Meiryo", "Noto Sans JP", "Segoe UI", Roboto, sans-serif;
    background: linear-gradient(160deg, #fff5f8 0%, #ffe4ec 40%, #ffd6e5 70%, #ffe8f0 100%);
    min-height: 100vh;
    color: var(--text);
    overflow-x: hidden;
  }

  /* Cute custom scrollbars */
  .cute-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: var(--pink-300) transparent;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .cute-scrollbar::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  .cute-scrollbar::-webkit-scrollbar-track {
    background: rgba(255, 194, 212, 0.15);
    border-radius: 9999px;
  }
  .cute-scrollbar::-webkit-scrollbar-thumb {
    background: var(--pink-300);
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.6);
  }
  .cute-scrollbar::-webkit-scrollbar-thumb:hover {
    background: var(--pink-400);
  }

  .hearts {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  .heart {
    position: absolute;
    font-size: 18px;
    opacity: 0.18;
    animation: floatHeart 12s infinite ease-in-out;
    will-change: transform, opacity;
    filter: drop-shadow(0 0 4px rgba(255, 182, 193, 0.4));
  }
  .heart.glitter {
    filter: drop-shadow(0 0 6px rgba(255, 220, 240, 0.75)) drop-shadow(0 0 12px rgba(255, 150, 200, 0.4));
  }
  /* Tiny glowing circle particles */
  .sparkle-dot {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    will-change: transform, opacity;
  }
  @keyframes floatHeart {
    0%, 100% { transform: translateY(0) translateX(0) rotate(0deg) scale(1); }
    25% { transform: translateY(-18px) translateX(8px) rotate(8deg) scale(1.05); }
    50% { transform: translateY(-32px) translateX(-6px) rotate(-6deg) scale(0.96); }
    75% { transform: translateY(-14px) translateX(10px) rotate(10deg) scale(1.03); }
  }
  @keyframes sparkle {
    0%, 100% { opacity: 0.15; transform: scale(0.8) rotate(0deg); }
    40% { opacity: 0.65; transform: scale(1.25) rotate(12deg); }
    60% { opacity: 0.3; transform: scale(1.05) rotate(-8deg); }
  }
  @keyframes glitterTwinkle {
    0%, 100% { opacity: 0.15; transform: scale(0.6); }
    20% { opacity: 0.9; transform: scale(1.3); }
    40% { opacity: 0.25; transform: scale(0.85); }
    60% { opacity: 0.75; transform: scale(1.15); }
    80% { opacity: 0.2; transform: scale(0.7); }
  }

  .app {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin: 0 auto;
    padding: 20px 16px 60px;
  }

  header {
    text-align: center;
    margin-bottom: 28px;
  }
  .logo {
    font-family: 'Pacifico', cursive;
    font-size: 2.7rem;
    background: linear-gradient(135deg, var(--pink-500), #c77dff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 4px;
    cursor: pointer;
  }
  .tagline {
    color: var(--text-soft);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .screen {
    display: none;
    animation: fadeIn 0.25s ease;
  }
  .screen.active {
    display: block;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 22px;
    border: none;
    border-radius: 50px;
    font-family: inherit;
    font-weight: 600;
    font-size: 0.92rem;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-soft);
  }
  .btn:active {
    transform: scale(0.97);
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--pink-400), var(--pink-500));
    color: white;
  }
  .btn-primary:hover {
    box-shadow: 0 6px 20px rgba(255, 92, 138, 0.35);
    transform: translateY(-1px);
  }
  .btn-secondary {
    background: white;
    color: var(--pink-500);
    border: 2px solid var(--pink-200);
  }
  .btn-secondary:hover {
    background: var(--pink-50);
  }
  .btn-sm {
    padding: 7px 15px;
    font-size: 0.82rem;
  }
  .btn-icon {
    width: 36px;
    height: 36px;
    padding: 0;
    border-radius: 50%;
    font-size: 1.1rem;
  }

  .card {
    background: var(--white);
    border-radius: 24px;
    padding: 24px;
    box-shadow: var(--shadow);
    border: 1px solid rgba(255, 182, 193, 0.4);
  }
  .panel {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(8px);
    border-radius: 20px;
    padding: 16px;
    border: 1px solid rgba(255, 182, 193, 0.35);
  }

  .deck-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 18px;
    margin-top: 24px;
  }
  .deck-card {
    background: white;
    border-radius: 20px;
    padding: 20px;
    box-shadow: var(--shadow-soft);
    border: 2px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }
  .deck-card:hover {
    border-color: var(--pink-300);
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .deck-card h3 {
    font-size: 1.15rem;
    margin-bottom: 6px;
    color: var(--text);
  }
  .deck-card p {
    font-size: 0.85rem;
    color: var(--text-soft);
  }
  .deck-card .count {
    display: inline-block;
    margin-top: 12px;
    background: var(--pink-100);
    color: var(--pink-500);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 20px;
  }
  .deck-actions {
    position: absolute;
    top: 14px;
    right: 14px;
    display: flex;
    gap: 6px;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .deck-card:hover .deck-actions {
    opacity: 1;
  }

  .form-group {
    margin-bottom: 16px;
  }
  .form-group label {
    display: block;
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: 6px;
    color: var(--text);
  }
  input[type="text"], textarea {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid var(--pink-100);
    border-radius: 14px;
    font-family: inherit;
    font-size: 0.95rem;
    background: white;
    color: var(--text);
    transition: border-color 0.2s;
  }
  input[type="text"]:focus, textarea:focus {
    outline: none;
    border-color: var(--pink-300);
  }
  .card-pair {
    background: var(--pink-50);
    border-radius: 16px;
    padding: 16px;
    margin-bottom: 14px;
    border: 1px solid var(--pink-100);
    position: relative;
  }
  .card-pair .remove-pair {
    position: absolute;
    top: 10px;
    right: 10px;
    background: none;
    border: none;
    font-size: 1.1rem;
    cursor: pointer;
    color: var(--pink-400);
  }

  /* Flashcard with slide transitions */
  .flashcard-wrapper {
    perspective: 1000px;
    height: 330px;
    margin-bottom: 24px;
    position: relative;
  }
  .flashcard-slider {
    width: 100%;
    height: 100%;
    transition: transform 0.2s ease-out, opacity 0.2s ease-out;
  }
  .flashcard-slider.slide-out-left {
    transform: translateX(-50px) scale(0.96);
    opacity: 0;
  }
  .flashcard-slider.slide-out-right {
    transform: translateX(50px) scale(0.96);
    opacity: 0;
  }
  .flashcard-slider.slide-in-right {
    transition: none !important;
    transform: translateX(50px) scale(0.96);
    opacity: 0;
  }
  .flashcard-slider.slide-in-left {
    transition: none !important;
    transform: translateX(-50px) scale(0.96);
    opacity: 0;
  }
  .flashcard {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.5s;
    transform-style: preserve-3d;
    cursor: pointer;
  }
  .flashcard.flipped {
    transform: rotateY(180deg);
  }
  .flashcard-face {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    border-radius: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px;
    text-align: center;
    box-shadow: var(--shadow);
  }
  .flashcard-front {
    background: #ffffff;
    border: 3px solid var(--pink-200);
    color: var(--text);
  }
  .flashcard-back {
    background: #ffffff;
    border: 3px solid var(--pink-200);
    color: var(--text);
    transform: rotateY(180deg);
  }

  /* Match Board */
  .match-board {
    display: grid;
    gap: 14px;
    margin-top: 18px;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }
  .match-board.grid-6 {
    grid-template-columns: repeat(3, 1fr);
  }
  .match-board.grid-12 {
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 640px) {
    .match-board.grid-6 {
      grid-template-columns: repeat(2, 1fr);
    }
    .match-board.grid-12 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .match-tile {
    height: 150px;
    background: white;
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 12px;
    text-align: center;
    cursor: pointer;
    border: 3px solid var(--pink-100);
    box-shadow: var(--shadow-soft);
    transition: all 0.2s;
    user-select: none;
    position: relative;
  }
  .match-tile:hover:not(.matched):not(.selected) {
    border-color: var(--pink-300);
    transform: translateY(-2px);
  }
  .match-tile.selected {
    border-color: var(--pink-500);
    background: var(--pink-50);
    box-shadow: 0 0 0 3px rgba(255, 92, 138, 0.25);
  }
  .match-tile.matched {
    background: linear-gradient(135deg, #e8fbf0, #d4f5e0);
    border-color: #7dd3a0;
    color: #1b5e39;
    cursor: default;
    opacity: 0.85;
  }
  .match-tile.wrong {
    animation: shake 0.4s;
    border-color: #ff8a8a;
  }
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    75% { transform: translateX(6px); }
  }

  .match-tile-content {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    text-align: center;
    word-break: break-word;
    padding: 4px;
  }
  /* margin:auto centers short text, but long text starts at the TOP and scrolls fully
     (align-items:center on the scroller used to cut off the top of long text) */
  .match-tile-content > span {
    margin: auto;
    max-width: 100%;
  }

  /* Asteroid Arcade */
  .asteroid-area {
    position: relative;
    height: 420px;
    background: linear-gradient(180deg, #1a1025 0%, #2d1b3d 40%, #4a2c5a 100%);
    border-radius: 24px;
    overflow: hidden;
    border: 3px solid var(--pink-300);
    box-shadow: var(--shadow);
  }
  .stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(2px 2px at 25px 35px, #ffffff, transparent),
      radial-gradient(2px 2px at 75px 85px, rgba(255,200,220,0.8), transparent),
      radial-gradient(1.5px 1.5px at 140px 60px, #ffffff, transparent),
      radial-gradient(2px 2px at 210px 140px, rgba(255,255,255,0.7), transparent),
      radial-gradient(1.5px 1.5px at 290px 45px, rgba(200,220,255,0.8), transparent),
      radial-gradient(2px 2px at 360px 105px, #ffffff, transparent);
    background-size: 450px 160px;
    opacity: 0.65;
    animation: twinkle 4s infinite alternate;
  }
  @keyframes twinkle {
    from { opacity: 0.4; }
    to { opacity: 0.8; }
  }
  .asteroid {
    position: absolute;
    background: linear-gradient(145deg, #ff9ebb, #ff5c8a);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    text-align: center;
    font-weight: 700;
    color: white;
    box-shadow: 0 0 22px rgba(255, 122, 162, 0.45), inset 0 0 14px rgba(255,255,255,0.25);
    cursor: pointer;
    user-select: none;
    border: 2px solid rgba(255,255,255,0.4);
    word-break: break-word;
    hyphens: auto;
    line-height: 1.25;
  }
  .asteroid.target {
    box-shadow: 0 0 0 4px #ffffff, 0 0 28px rgba(255,255,255,0.9);
    transform: scale(1.08);
  }
  .asteroid.hit {
    animation: explode 0.35s forwards;
  }
  @keyframes explode {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.35); opacity: 0.7; }
    100% { transform: scale(0); opacity: 0; }
  }

  .game-hud {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    flex-wrap: gap;
    gap: 8px;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .badge {
    background: white;
    padding: 6px 14px;
    border-radius: 20px;
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--pink-100);
  }

  .mode-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-top: 20px;
  }
  .mode-card {
    background: white;
    border-radius: 20px;
    padding: 24px 16px;
    text-align: center;
    cursor: pointer;
    border: 2px solid transparent;
    box-shadow: var(--shadow-soft);
    transition: all 0.2s;
  }
  .mode-card:hover {
    border-color: var(--pink-300);
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .mode-card .icon {
    font-size: 2.5rem;
    margin-bottom: 8px;
  }

  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 10px;
  }
  .back-btn {
    background: white;
    border: 2px solid var(--pink-100);
    color: var(--pink-500);
    padding: 8px 16px;
    border-radius: 50px;
    font-weight: 600;
    cursor: pointer;
    font-size: 0.9rem;
    transition: all 0.2s;
  }
  .back-btn:hover {
    background: var(--pink-50);
  }

  .toast {
    position: fixed;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%) translateY(90px);
    background: white;
    color: var(--text);
    padding: 12px 24px;
    border-radius: 50px;
    box-shadow: var(--shadow);
    font-weight: 700;
    font-size: 0.9rem;
    z-index: 100;
    transition: transform 0.3s ease;
    border: 2px solid var(--pink-200);
    pointer-events: none;
  }
  .toast.show {
    transform: translateX(-50%) translateY(0);
  }

  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(90, 61, 74, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
    backdrop-filter: blur(4px);
  }
  .overlay.show {
    opacity: 1;
    pointer-events: all;
  }
  .overlay-card {
    background: white;
    border-radius: 24px;
    padding: 32px 24px;
    text-align: center;
    max-width: 360px;
    width: 90%;
    box-shadow: var(--shadow);
    transform: scale(0.9);
    transition: transform 0.3s;
    border: 2px solid var(--pink-200);
  }
  .overlay.show .overlay-card {
    transform: scale(1);
  }
</style>
</head>
<body>
  <div class="hearts" id="hearts"></div>

  <div class="app">
    <header>
      <div class="logo" onclick="showScreen('home')">Pastel Cards 💕</div>
      <div class="tagline">cute study vibes only</div>
    </header>

    <!-- HOME -->
    <div id="home" class="screen active">
      <div style="background:rgba(255, 255, 255, 0.75); border:1px solid var(--pink-200); border-radius:18px; padding:10px 16px; margin-bottom:16px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
        <div style="display:flex; align-items:center; gap:8px; font-size:0.85rem; font-weight:600; color:var(--text);">
          <span>🌸 <strong>100% Offline &amp; Cookie-Free</strong></span>
          <span style="font-size:0.75rem; color:var(--text-soft);">(Zero cookies, no logins, no internet needed)</span>
        </div>
        <div style="display:flex; gap:6px;">
          <button class="btn btn-secondary btn-sm" onclick="exportDecksJson()" title="Download a JSON backup of your decks">💾 Backup Decks</button>
          <label class="btn btn-secondary btn-sm" style="cursor:pointer;" title="Restore decks from a JSON file">
            📂 Restore
            <input type="file" id="restoreFileInput" accept=".json" onchange="importDecksJson(event)" style="display:none;">
          </label>
        </div>
      </div>

      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <h2 style="font-size:1.3rem;">Your Decks</h2>
        <div style="display:flex; gap:8px;">
          <button class="btn btn-primary" onclick="showCreate()">＋ New Deck</button>
        </div>
      </div>
      <div id="deckList" class="deck-grid"></div>
      <div id="emptyState" style="text-align:center; padding:60px 20px; display:none;">
        <div style="font-size:3.5rem; margin-bottom:12px;">🌸</div>
        <p style="color:var(--text-soft);">No decks yet. Create your first one!</p>
      </div>
    </div>

    <!-- CREATE / EDIT -->
    <div id="create" class="screen">
      <div class="top-bar">
        <button class="back-btn" onclick="showScreen('home')">← Back</button>
        <h2 id="createTitle" style="font-size:1.2rem;">New Deck</h2>
        <div style="width:70px;"></div>
      </div>
      <div class="card">
        <div class="form-group">
          <label>Deck Name</label>
          <input type="text" id="deckName" placeholder="e.g. Japanese Vocab 💕">
        </div>

        <div style="background:#fcf5ff; border-radius:16px; padding:16px; margin-bottom:18px; border:1px solid #e8d5f2;">
          <h3 style="font-size:0.95rem; margin-bottom:8px;">📋 Import List</h3>
          <p style="font-size:0.8rem; color:var(--text-soft); margin-bottom:10px;">
            Paste <strong>term - definition</strong> (one per line):
          </p>
          <textarea id="importText" rows="5" placeholder="いいえ - no; you're welcome
鉛筆/えんぴつ - pencil
学生/がくせい - student"></textarea>
          <div style="display:flex; gap:8px; margin-top:8px;">
            <button class="btn btn-primary btn-sm" onclick="doImport()">Import Cards</button>
            <button class="btn btn-secondary btn-sm" onclick="document.getElementById('importText').value=''">Clear</button>
          </div>
          <p id="importResult" style="font-size:0.85rem; color:var(--text-soft); margin-top:8px;"></p>
        </div>

        <div id="pairsContainer"></div>
        <button class="btn btn-secondary btn-sm" onclick="addPair()" style="margin-bottom:16px;">＋ Add Card</button>
        <div style="display:flex; gap:10px;">
          <button class="btn btn-primary" onclick="saveDeck()">Save Deck 💖</button>
          <button class="btn btn-secondary" onclick="showScreen('home')">Cancel</button>
        </div>
      </div>
    </div>

    <!-- DECK DETAIL -->
    <div id="deckDetail" class="screen">
      <div class="top-bar">
        <button class="back-btn" onclick="showScreen('home')">← Back</button>
        <h2 id="detailTitle" style="font-size:1.2rem;"></h2>
        <button class="btn btn-secondary btn-sm" onclick="editCurrentDeck()">Edit</button>
      </div>
      <div class="panel" style="text-align:center; margin-bottom:12px;">
        <p id="detailCount" style="color:var(--text-soft); font-weight:600;"></p>
        <div id="levelSummary" style="display:flex; justify-content:center; flex-wrap:wrap; gap:8px; margin-top:10px;"></div>
        <button class="btn btn-secondary btn-sm" style="margin-top:12px;" onclick="resetProgress()" title="Start every card in this deck over as New">↺ Reset progress</button>
      </div>

      <div style="display:flex; align-items:center; justify-content:center; gap:10px; margin-bottom:16px;">
