<script>
  // Starter decks
  const DEFAULT_DATA = [
    {
      id: 'japanese-starter',
      name: 'Japanese Vocab 💕',
      cards: [
        { id: 'c1', term: 'いいえ', def: "no; you're welcome (polite denial or modest deflection)", starred: true },
        { id: 'c2', term: '鉛筆 / えんぴつ', def: 'pencil — wooden graphite instrument used for sketching and notes', starred: false },
        { id: 'c3', term: '学生 / がくせい', def: 'student — someone studying at school, college, or university', starred: true },
        { id: 'c4', term: 'ありがとう', def: 'thank you (polite and friendly gratitude)', starred: false },
        { id: 'c5', term: '可愛い / かわいい', def: 'cute, adorable, lovable, or charming', starred: true },
        { id: 'c6', term: '桜 / さくら', def: 'cherry blossom (iconic pink spring flowers)', starred: true },
        { id: 'c7', term: '猫 / ねこ', def: 'cat — affectionate four-legged companion animal', starred: false },
        { id: 'c8', term: '本 / ほん', def: 'book — collection of pages bound with stories or knowledge', starred: false }
      ]
    }
  ];

  // 100% Cookie-free, safe offline storage with in-memory fallback.
  // Never uses cookies, and never throws SecurityError on iOS/Safari/Private Browsing.
  const SafeStorage = {
    _mem: {},
    get(key, fallback) {
      try {
        if (typeof window !== 'undefined' && 'localStorage' in window) {
          const item = window.localStorage.getItem(key);
          if (item) return JSON.parse(item);
        }
      } catch (e) {
        // Storage restricted or disabled in Safari/iOS private browsing
      }
      return this._mem[key] !== undefined ? this._mem[key] : fallback;
    },
    set(key, value) {
      this._mem[key] = value;
      try {
        if (typeof window !== 'undefined' && 'localStorage' in window) {
          window.localStorage.setItem(key, JSON.stringify(value));
        }
      } catch (e) {
        // Storage restricted, safe in-memory fallback
      }
    }
  };

  // ============================================================
  //  SMART SRS  (shared by Study, Match and Asteroid)
  //  Every card keeps its own history in card.srs:
  //    box    0-6   how well it is known (Leitner box)
  //    reps         total times answered       correct / wrong  counters
  //    hard   0-10  "trouble score": goes up when you miss it, down when you get it
  //    due          timestamp when the card may be promoted again (spaced repetition)
  //  Levels:  New (never answered) -> Familiar (box 1-3) -> Learned (box 4-5) -> Mastered (box 6)
  //  Learned needs 4 right in a row. Mastered needs correct answers on spaced-out days
  //  (1 day, then 7 days later), so cramming can't fake "never forget".
  // ============================================================
  const DAY_MS = 86400000;
  const BOX_MAX = 6;
  const BOX_REST_DAYS = [0, 0, 0, 0, 1, 7, 30]; // how long a card rests after reaching each box

  const LEVELS = {
    new:      { label: 'New',      emoji: '🆕', bg: '#f3e8ff', fg: '#8a4fc7' },
    familiar: { label: 'Familiar', emoji: '🌱', bg: '#fff3cd', fg: '#8a6100' },
    learned:  { label: 'Learned',  emoji: '🌸', bg: '#dff7e8', fg: '#1f6b43' },
    mastered: { label: 'Mastered', emoji: '👑', bg: '#ffd9e6', fg: '#b3194f' }
  };
  const LEVEL_WEIGHT = { new: 1.6, familiar: 2.2, learned: 1.0, mastered: 0.3 };

  function newSrs() {
    return { box: 0, reps: 0, correct: 0, wrong: 0, streak: 0, hard: 0, last: 0, due: 0 };
  }

  function ensureSrs(card) {
    if (!card.srs || typeof card.srs !== 'object') card.srs = newSrs();
    const base = newSrs();
    Object.keys(base).forEach(k => { if (typeof card.srs[k] !== 'number' || isNaN(card.srs[k])) card.srs[k] = base[k]; });
    return card.srs;
  }

  function cardLevel(card) {
    const s = ensureSrs(card);
    if (!s.reps) return 'new';
    if (s.box >= BOX_MAX) return 'mastered';
    if (s.box >= 4) return 'learned';
    return 'familiar';
  }

  function isHardCard(card) {
    return ensureSrs(card).hard >= 2;
  }

  // result: 'ok' (knew it) | 'again' (shaky, show it again) | 'hard' (didn't know it) | 'miss' (wrong in a game)
  function recordAnswer(card, result) {
    const s = ensureSrs(card);
    const now = Date.now();
    s.reps++;
    s.last = now;

    if (result === 'ok') {
      s.correct++;
      s.streak++;
      s.hard = Math.max(0, s.hard - 1);
      // Boxes 0-3 climb on every right answer. From box 4 up the card must have rested first.
      if (s.box < 4 || now >= s.due) {
        if (s.box < BOX_MAX) s.box++;
        s.due = now + BOX_REST_DAYS[s.box] * DAY_MS;
      }
    } else if (result === 'again') {
      s.streak = 0;
      s.hard = Math.min(10, s.hard + 0.5);
      s.box = Math.max(1, s.box - 1);
      s.due = 0;
    } else { // 'hard' or 'miss'
      s.wrong++;
      s.streak = 0;
      s.hard = Math.min(10, s.hard + (result === 'hard' ? 2 : 1));
      s.box = result === 'hard' ? Math.max(1, Math.floor(s.box / 2)) : Math.max(1, s.box - 1);
      s.due = 0;
    }
    saveToStorage();
  }

  // How likely a card is to be picked: hard cards a lot more, new/familiar more than learned,
  // mastered cards that are still "resting" hardly ever.
  function cardWeight(card) {
    const s = ensureSrs(card);
    let w = LEVEL_WEIGHT[cardLevel(card)] * (1 + s.hard * 1.2);
    if (s.reps && Date.now() < s.due) w *= 0.35;
    return w;
  }

  // Weighted random order (Efraimidis-Spirakis): random every time, but heavy cards tend to come first
  function weightedShuffle(cards, weightFn = cardWeight) {
    return cards
      .map(c => ({ c, k: Math.pow(Math.random(), 1 / Math.max(0.01, weightFn(c))) }))
      .sort((a, b) => b.k - a.k)
      .map(x => x.c);
  }

  function weightedSample(cards, n, weightFn = cardWeight) {
    return weightedShuffle(cards, weightFn).slice(0, n);
  }

  function chipHtml(text, bg, fg) {
    return `<span style="display:inline-block; background:${bg}; color:${fg}; font-size:0.74rem; font-weight:700; padding:3px 11px; border-radius:20px; white-space:nowrap;">${text}</span>`;
  }
  function levelChip(card) {
    const L = LEVELS[cardLevel(card)];
    return chipHtml(`${L.emoji} ${L.label}`, L.bg, L.fg);
  }
  function hardChip() {
    return chipHtml('🔥 Hard', '#ffe0e6', '#9b2c3e');
  }

  let decks = SafeStorage.get('pastelDecks_standalone', DEFAULT_DATA);
  decks.forEach(d => (d.cards || []).forEach(ensureSrs));
  let currentDeckId = null;
  let editingId = null;
  let currentCards = [];

  // Study state
  let studyIndex = 0;
  let studyFlipped = false;
  let isNavigating = false;

  // Match state
  let matchLimit = 6; // DEFAULT: 6 CARDS TOTAL
  let matchTiles = [];
  let selectedTiles = [];
  let matchMoves = 0;
  let matchMatched = 0;
  let matchLocked = false;
  let matchMiss = new Set(); // cards already counted as missed this game

  // Asteroid state
  let challengeMode = false; // DEFAULT: NO LIVES (Chill Practice)
  let astroSpeed = 'gentle'; // DEFAULT: GENTLE, NOT TOO FAST
  let astroScore = 0;
  let astroLives = 3;
  let astroActive = [];
  let astroTargetIdx = -1;
  let astroInterval = null;
  let astroSpawnTimer = null;
  let astroSeen = new Set(); // cards already shown this game (unseen cards get a boost)
  let astroLast = null;

  // Web Audio Cute Sound Synthesizer
  let audioCtx = null;
  let soundEnabled = true;

  function getAudioCtx() {
    try {
      if (!audioCtx) {
        const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
        if (AudioCtxClass) audioCtx = new AudioCtxClass();
      }
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    } catch (e) {
      return null;
    }
  }

  function playCuteSuccess() {
    if (!soundEnabled) return;
    const ctx = getAudioCtx();
    if (!ctx) return;
    const now = ctx.currentTime;
    const notes = [
      { freq: 1046.5, delay: 0 },
      { freq: 1318.5, delay: 0.075 },
      { freq: 1568.0, delay: 0.15 }
    ];
    notes.forEach(n => {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(n.freq, now + n.delay);
      gain.gain.setValueAtTime(0, now + n.delay);
      gain.gain.linearRampToValueAtTime(0.14, now + n.delay + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + n.delay + 0.35);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now + n.delay);
      osc.stop(now + n.delay + 0.38);
    });
  }

  function playCuteVictory() {
    if (!soundEnabled) return;
    const ctx = getAudioCtx();
    if (!ctx) return;
    const now = ctx.currentTime;
    const notes = [
      { freq: 783.99, delay: 0 },
      { freq: 1046.5, delay: 0.09 },
      { freq: 1318.5, delay: 0.18 },
      { freq: 1567.98, delay: 0.27 },
      { freq: 2093.0, delay: 0.38 }
    ];
    notes.forEach(n => {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(n.freq, now + n.delay);
      gain.gain.setValueAtTime(0, now + n.delay);
      gain.gain.linearRampToValueAtTime(0.16, now + n.delay + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + n.delay + 0.45);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now + n.delay);
      osc.stop(now + n.delay + 0.5);
    });
  }

  function saveToStorage() {
    SafeStorage.set('pastelDecks_standalone', decks);
  }

  function exportDecksJson() {
    try {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(decks, null, 2));
      const dlAnchor = document.createElement('a');
      dlAnchor.setAttribute("href", dataStr);
      dlAnchor.setAttribute("download", "pastel-decks-backup.json");
      document.body.appendChild(dlAnchor);
      dlAnchor.click();
      dlAnchor.remove();
      toast('Decks exported! 💖 (Offline JSON)');
    } catch (e) {
      toast('Export error: ' + (e.message || 'failed'));
    }
  }

  function importDecksJson(event) {
    const file = event.target.files && event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
      try {
        const imported = JSON.parse(e.target.result);
        const valid = Array.isArray(imported) && imported.length > 0 && imported.every(d =>
          d && typeof d.name === 'string' && Array.isArray(d.cards) &&
          d.cards.every(c => c && typeof c.term === 'string' && typeof c.def === 'string'));
        if (valid) {
          imported.forEach((d, i) => {
            if (!d.id) d.id = `deck-restored-${Date.now()}-${i}`;
            d.cards.forEach((c, j) => { if (!c.id) c.id = `c-restored-${Date.now()}-${i}-${j}`; ensureSrs(c); });
          });
          decks = imported;
          saveToStorage();
          renderHome();
          toast('Decks restored! 💕 (' + imported.length + ' decks)');
        } else {
          toast('Invalid deck backup file format');
        }
      } catch (err) {
        toast('Could not read JSON backup file');
      }
      event.target.value = '';
    };
    reader.readAsText(file);
  }

  function showScreen(id) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    if (id === 'home') renderHome();
    if (id === 'deckDetail') renderCardList();
  }

  function toast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2200);
  }

  function showOverlay(emoji, title, msg, buttons) {
    document.getElementById('overlayEmoji').textContent = emoji;
    document.getElementById('overlayTitle').textContent = title;
    document.getElementById('overlayMsg').textContent = msg;
    const actions = document.getElementById('overlayActions');
    actions.innerHTML = '';
    buttons.forEach(b => {
      const btn = document.createElement('button');
      btn.className = b.primary ? 'btn btn-primary' : 'btn btn-secondary';
      btn.textContent = b.text;
      btn.onclick = () => { closeOverlay(); b.action(); };
      actions.appendChild(btn);
    });
    document.getElementById('overlay').classList.add('show');
  }

  function closeOverlay() {
    document.getElementById('overlay').classList.remove('show');
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // Fisher-Yates shuffle (returns a new array, original untouched)
  function shuffle(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  // CJK detector
  function isCJK(str) {
    return /[\u3000-\u303f\u3040-\u309f\u30a0-\u30ff\uff00-\uff9f\u4e00-\u9faf\u3400-\u4dbf\uac00-\ud7af]/.test(str);
  }

  // Font sizing helper for match tiles so Japanese words look large and prominent
  function getTileTypography(text) {
    const len = text.trim().length;
    const cjk = isCJK(text);

    if (cjk) {
      if (len <= 4) return 'font-size: 1.65rem; font-weight: 700; letter-spacing: 0.04em;';
      if (len <= 9) return 'font-size: 1.35rem; font-weight: 700; letter-spacing: 0.02em;';
      if (len <= 16) return 'font-size: 1.12rem; font-weight: 700;';
      if (len <= 28) return 'font-size: 0.95rem; font-weight: 600;';
      return 'font-size: 0.85rem; font-weight: 500;';
    }

    if (len <= 8) return 'font-size: 1.25rem; font-weight: 700;';
    if (len <= 18) return 'font-size: 1.05rem; font-weight: 600;';
    if (len <= 35) return 'font-size: 0.92rem; font-weight: 600;';
    return 'font-size: 0.82rem; font-weight: 500;';
  }

  // Dynamic circle sizing for Asteroid terms so letters/words NEVER spill outside
  function calculateAsteroidMetrics(term) {
    const trimmed = term.trim();
    const len = trimmed.length;
    const words = trimmed.split(/[\s/—–-]+/).filter(Boolean);
    const wordCount = words.length;
    const maxWordLen = words.reduce((max, w) => Math.max(max, w.length), 0);

    let diameter = 88;
    let fontSize = '0.95rem';

    if (len <= 4 && wordCount <= 1) {
      diameter = 88;
      fontSize = '0.96rem';
    } else if (len <= 8 && wordCount <= 2) {
      diameter = 105;
      fontSize = '0.90rem';
    } else if (len <= 14) {
      diameter = 124 + (wordCount > 2 ? 12 : 0) + (maxWordLen > 8 ? 8 : 0);
      fontSize = '0.84rem';
    } else if (len <= 24) {
      diameter = 144 + (wordCount > 3 ? 14 : 0);
      fontSize = '0.78rem';
    } else if (len <= 38) {
      diameter = 168 + (wordCount > 4 ? 14 : 0);
      fontSize = '0.74rem';
    } else {
      diameter = Math.min(210, 175 + (len - 38) * 1.3);
      fontSize = '0.70rem';
    }

    return { diameter, fontSize };
  }

