  // Builds inputs with the DOM (not innerHTML) so quotes/special characters in cards never break the form.
  // cardId lets us keep a card's star + learning progress when the deck is saved.
  function addPair(term = '', def = '', cardId = '') {
    const container = document.getElementById('pairsContainer');
    const div = document.createElement('div');
    div.className = 'card-pair';
    if (cardId) div.dataset.cardId = cardId;
    div.innerHTML = `
      <button class="remove-pair" type="button" title="Remove card" onclick="this.parentElement.remove()">✕</button>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
        <div class="form-group" style="margin:0;">
          <label>Term</label>
          <input type="text" class="term-input" placeholder="Term">
        </div>
        <div class="form-group" style="margin:0;">
          <label>Definition</label>
          <input type="text" class="def-input" placeholder="Definition">
        </div>
      </div>
    `;
    div.querySelector('.term-input').value = term;
    div.querySelector('.def-input').value = def;
    container.appendChild(div);
    return div;
  }

  function pairIsEmpty(p) {
    return !p.querySelector('.term-input').value.trim() && !p.querySelector('.def-input').value.trim();
  }

  // Import ADDS to whatever cards are already in the form (it never wipes them).
  function doImport() {
    const raw = document.getElementById('importText').value.trim();
    const resultEl = document.getElementById('importResult');
    if (!raw) {
      toast('Paste some cards first 💕');
      return;
    }
    const lines = raw.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
    const found = [];
    let skipped = 0;

    for (const line of lines) {
      // Prefer " - " (spaces around the dash) so hyphenated words like "well-known" stay intact;
      // fall back to a tab, a colon, or a bare dash.
      const m = line.match(/^(.+?)\s+[-–—]\s+(.+)$/) ||
                line.match(/^(.+?)\s*\t\s*(.+)$/) ||
                line.match(/^(.+?)\s*[:：]\s*(.+)$/) ||
                line.match(/^(.+?)\s*[-–—]\s*(.+)$/);
      if (m && m[1].trim() && m[2].trim()) {
        found.push({ term: m[1].trim(), def: m[2].trim() });
      } else {
        skipped++;
      }
    }

    if (!found.length) {
      resultEl.textContent = '⚠️ No valid pairs found. Use the format: term - definition';
      toast('No valid pairs found. Format: term - def');
      return;
    }

    const container = document.getElementById('pairsContainer');
    // Drop untouched blank rows so imported cards don't sit under empty ones
    container.querySelectorAll('.card-pair').forEach(p => { if (pairIsEmpty(p)) p.remove(); });

    // Skip cards that are already in the deck (same term + definition)
    const existing = new Set();
    container.querySelectorAll('.card-pair').forEach(p => {
      existing.add(p.querySelector('.term-input').value.trim() + '\u0000' + p.querySelector('.def-input').value.trim());
    });

    let added = 0, dupes = 0, firstNew = null;
    found.forEach(p => {
      const key = p.term + '\u0000' + p.def;
      if (existing.has(key)) { dupes++; return; }
      existing.add(key);
      const row = addPair(p.term, p.def);
      if (!firstNew) firstNew = row;
      added++;
    });

    const total = container.querySelectorAll('.card-pair').length;
    let msg = added ? `✅ Added ${added} new card${added === 1 ? '' : 's'} (deck now has ${total})` : 'No new cards added';
    if (dupes) msg += ` · ${dupes} duplicate${dupes === 1 ? '' : 's'} skipped`;
    if (skipped) msg += ` · ${skipped} line${skipped === 1 ? '' : 's'} not understood`;
    msg += ' — press Save Deck 💖 to keep them.';
    resultEl.textContent = msg;
    toast(added ? `Added ${added} card${added === 1 ? '' : 's'} 💕` : 'Those cards are already in the deck');

    document.getElementById('importText').value = ''; // lines were processed, so clear the box
    if (firstNew) firstNew.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function saveDeck() {
    const name = document.getElementById('deckName').value.trim();
    if (!name) { toast('Please give your deck a name'); return; }

    if (document.getElementById('importText').value.trim()) {
      toast('You have pasted text that is not imported yet — press Import Cards first 💕');
      return;
    }

    const deck = editingId ? decks.find(d => d.id === editingId) : null;
    const pairs = [];
    document.querySelectorAll('#pairsContainer .card-pair').forEach(p => {
      const term = p.querySelector('.term-input').value.trim();
      const def = p.querySelector('.def-input').value.trim();
      if (!term || !def) return;
      // Keep star + learning progress of existing cards (matched by id, falling back to term)
      const oldId = p.dataset.cardId;
      const old = deck ? (deck.cards.find(c => c.id === oldId) || deck.cards.find(c => c.term === term)) : null;
      pairs.push({
        id: old && old.id ? old.id : `c-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
        term,
        def,
        starred: old ? !!old.starred : false,
        srs: old && old.srs ? old.srs : newSrs()
      });
    });

    if (pairs.length < 1) {
      toast('Add at least 1 card with a term and a definition 💕');
      return;
    }

    let targetId;
    if (deck) {
      deck.name = name;
      deck.cards = pairs;
      targetId = deck.id;
      toast('Deck updated 💖');
    } else {
      targetId = `deck-${Date.now()}`;
      decks.unshift({ id: targetId, name, cards: pairs });
      toast('Deck created 🌸');
    }

    editingId = null;
    saveToStorage();
    openDeck(targetId);
  }

  // --- STUDY MODE (smart SRS queue) ---
  // The round is a queue. "Ok" removes a card, "Again" brings it back a bit later,
  // "Hard" brings it back soon and it must be recalled twice before the round ends.
  let studyPool = [];
  let studyQueue = [];
  let studyTotal = 0;
  let studyDone = 0;
  let studyNeed = new Map();   // card -> how many more "Ok" answers it needs this round
  let studyMissed = new Set(); // cards rated Hard/Again at least once this round

  function beginStudyRound(cards) {
    studyPool = cards;
    const now = Date.now();
    // Mastered cards that are still resting stay out of the way, unless nothing else is left
    let pool = cards.filter(c => !(cardLevel(c) === 'mastered' && now < c.srs.due));
    const resting = cards.length - pool.length;
    if (!pool.length) pool = cards;
    studyQueue = weightedShuffle(pool); // random order, hard cards tend to come first
    studyTotal = studyQueue.length;
    studyDone = 0;
    studyNeed = new Map();
    studyMissed = new Set();
    studyFlipped = false;
    isNavigating = false;
    const slider = document.getElementById('flashcardSlider');
    if (slider) slider.className = 'flashcard-slider';
    if (resting && resting < cards.length) toast(`👑 ${resting} mastered card${resting === 1 ? ' is' : 's are'} resting until due`);
  }

  function startStudy() {
    const cards = getActiveCards();
    if (!cards || cards.length === 0) return;
    beginStudyRound(cards);
    showScreen('study');
    renderStudyCard();
  }

  function restartStudy() {
    if (!studyPool.length) return;
    beginStudyRound(studyPool);
    renderStudyCard();
  }

  function renderStudyCard() {
    const card = studyQueue[0];
    if (!card) return;
    document.getElementById('cardFront').textContent = card.term;
    document.getElementById('cardBack').textContent = card.def;
    // un-flip instantly (no rotate animation) so the next card's answer is never glimpsed
    const fc = document.getElementById('flashcard');
    fc.style.transition = 'none';
    fc.classList.remove('flipped');
    void fc.offsetWidth;
    fc.style.transition = '';
    studyFlipped = false;
    document.getElementById('srsButtons').style.display = 'none';
    document.getElementById('studyProgress').textContent = `✓ ${studyDone} / ${studyTotal} · ${studyQueue.length} left`;
    document.getElementById('studyBar').style.width = `${studyTotal ? (studyDone / studyTotal) * 100 : 0}%`;
    document.getElementById('studyBadge').innerHTML = levelChip(card) + (isHardCard(card) ? hardChip() : '');
  }

  function flipCard() {
    if (isNavigating || !studyQueue.length) return;
    const cardEl = document.getElementById('flashcard');
    cardEl.classList.toggle('flipped');
    studyFlipped = !studyFlipped;
    document.getElementById('srsButtons').style.display = studyFlipped ? 'flex' : 'none';
  }

  // Slide the current card away, then show whatever is first in the queue
  function advanceStudy() {
    isNavigating = true;
    const slider = document.getElementById('flashcardSlider');
    slider.className = 'flashcard-slider slide-out-left';
    setTimeout(() => {
      if (!studyQueue.length) {
        slider.className = 'flashcard-slider';
        isNavigating = false;
        finishStudy();
        return;
      }
      renderStudyCard();
      slider.className = 'flashcard-slider slide-in-right';
      requestAnimationFrame(() => {
        setTimeout(() => {
          slider.className = 'flashcard-slider';
          isNavigating = false;
        }, 30);
      });
    }, 180);
  }

  function requeueCurrent(gap) {
    const card = studyQueue.shift();
    studyQueue.splice(Math.min(gap, studyQueue.length), 0, card);
  }

  function rateCard(result) {
    if (isNavigating || !studyFlipped || !studyQueue.length) return;
    const card = studyQueue[0];
    recordAnswer(card, result);

    const need = studyNeed.get(card) || 0;
    if (result === 'again' || result === 'hard') {
      // "Again" = comes back more frequently (small gap)
      studyMissed.add(card);
      studyNeed.set(card, Math.max(1, need));
      requeueCurrent(2); // show again soon
    } else {
      playCuteSuccess();
      if (need > 1) {
        studyNeed.set(card, need - 1);
        requeueCurrent(4);
      } else {
        studyNeed.delete(card);
        studyQueue.shift();
        studyDone++;
      }
    }
    advanceStudy();
  }

  function skipCard() {
    if (isNavigating || !studyQueue.length) return;
    if (studyQueue.length < 2) {
      toast('This is the last card — rate it to finish 💕');
      return;
    }
    studyQueue.push(studyQueue.shift());
    advanceStudy();
  }

  function finishStudy() {
    playCuteVictory();
    document.getElementById('studyBar').style.width = '100%';
    document.getElementById('studyProgress').textContent = `✓ ${studyTotal} / ${studyTotal} · done!`;
    const first = studyTotal - studyMissed.size;
    let msg = `${first} of ${studyTotal} card${studyTotal === 1 ? '' : 's'} right the first time.`;
    if (studyMissed.size) msg += ` ${studyMissed.size} tricky one${studyMissed.size === 1 ? '' : 's'} will come back sooner next time 💪`;
    showOverlay('🌟', 'Round complete!', msg, [
      { text: 'Study Again ✨', primary: true, action: restartStudy },
      { text: 'Back to Deck', primary: false, action: () => showScreen('deckDetail') }
    ]);
  }

  // --- MATCH MODE (LIMITED TO 6 CARDS BY DEFAULT) ---
  function setMatchLimit(n) {
    matchLimit = n;
    document.getElementById('matchLimit6').className = n === 6 ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-secondary';
    document.getElementById('matchLimit12').className = n === 12 ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-secondary';
    startMatch();
  }

  function startMatch() {
    const cards = getActiveCards();
    if (!cards || cards.length < 2) {
      toast('Need at least 2 cards for Match');
      return;
    }

    const pairCount = matchLimit === 6 ? 3 : 6;
    const pairs = weightedSample(cards, pairCount); // hard / new cards are picked more often
    matchMiss = new Set();

    matchTiles = [];
    pairs.forEach((c, i) => {
      matchTiles.push({ id: `t${i}`, text: c.term, pairId: i, type: 'term', card: c });
      matchTiles.push({ id: `d${i}`, text: c.def, pairId: i, type: 'def', card: c });
    });

    for (let i = matchTiles.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [matchTiles[i], matchTiles[j]] = [matchTiles[j], matchTiles[i]];
    }

    selectedTiles = [];
    matchMoves = 0;
    matchMatched = 0;
    matchLocked = false;

    document.getElementById('matchMoves').textContent = '0';
    document.getElementById('matchMatched').textContent = '0';
    document.getElementById('matchTotal').textContent = matchTiles.length / 2;

    const board = document.getElementById('matchBoard');
    board.className = 'match-board ' + (matchLimit === 6 ? 'grid-6' : 'grid-12');
    board.innerHTML = '';

    matchTiles.forEach((tile, idx) => {
      const el = document.createElement('div');
      el.className = 'match-tile';
      el.dataset.idx = idx;

      // Type label
      const tag = document.createElement('div');
      tag.style.cssText = 'font-size:10px; font-weight:700; text-transform:uppercase; text-align:left; color:' + (tile.type === 'term' ? 'var(--pink-400)' : '#c77dff');
      tag.textContent = tile.type === 'term' ? 'Term' : 'Definition';

      // Scrollable content wrapper with wheel scrolling & large typography for Japanese/fitting words
      const content = document.createElement('div');
      content.className = 'match-tile-content cute-scrollbar';
      content.style.cssText += getTileTypography(tile.text);
      const inner = document.createElement('span');
      inner.textContent = tile.text;
      content.appendChild(inner);
      content.title = 'Scroll with mouse wheel to see more';

      el.appendChild(tag);
      el.appendChild(content);

      el.onclick = () => selectMatchTile(idx);
      board.appendChild(el);
    });

    showScreen('match');
  }

  function selectMatchTile(idx) {
    if (matchLocked) return;
    const tile = matchTiles[idx];
    const el = document.querySelector(`.match-tile[data-idx="${idx}"]`);
    if (el.classList.contains('matched')) return;

    // Tap a selected card again to change your mind
    if (el.classList.contains('selected')) {
      el.classList.remove('selected');
      selectedTiles = selectedTiles.filter(t => t.idx !== idx);
      return;
    }

    el.classList.add('selected');
    selectedTiles.push({ idx, tile, el });

    if (selectedTiles.length === 2) {
      matchMoves++;
      document.getElementById('matchMoves').textContent = matchMoves;
      matchLocked = true;

      const [a, b] = selectedTiles;
      if (a.tile.pairId === b.tile.pairId && a.tile.type !== b.tile.type) {
        // Matched! Cute success sound
        playCuteSuccess();
        if (!matchMiss.has(a.tile.card)) recordAnswer(a.tile.card, 'ok'); // right with no earlier mistake

        setTimeout(() => {
          a.el.classList.remove('selected');
          b.el.classList.remove('selected');
          a.el.classList.add('matched');
          b.el.classList.add('matched');
          matchMatched++;
          document.getElementById('matchMatched').textContent = matchMatched;
          selectedTiles = [];
          matchLocked = false;

          if (matchMatched === matchTiles.length / 2) {
            setTimeout(() => {
              playCuteVictory();
              showOverlay('🎉', 'Perfect Match!', `You matched all ${matchTiles.length} cards in ${matchMoves} moves!`, [
                { text: 'Play Again 💕', primary: true, action: startMatch },
                { text: 'Back to Deck', primary: false, action: () => showScreen('deckDetail') }
              ]);
            }, 350);
          }
        }, 320);
      } else {
        // Mismatch: completely silent, only visual shake!
        if (a.tile.type !== b.tile.type) { // term+definition that don't belong together = real mistake
          [a, b].forEach(t => {
            if (!matchMiss.has(t.tile.card)) { matchMiss.add(t.tile.card); recordAnswer(t.tile.card, 'miss'); }
          });
        }
        a.el.classList.add('wrong');
        b.el.classList.add('wrong');
        setTimeout(() => {
          a.el.classList.remove('selected', 'wrong');
          b.el.classList.remove('selected', 'wrong');
          selectedTiles = [];
          matchLocked = false;
        }, 700);
      }
    }
  }

  // --- ASTEROID MODE (MAX 2 AT A TIME, DYNAMIC CIRCLES, CHALLENGE TOGGLE) ---
  function toggleChallengeMode() {
    challengeMode = !challengeMode;
    const btn = document.getElementById('challengeBtn');
    const badge = document.getElementById('astroLivesBadge');
    if (challengeMode) {
      btn.className = 'btn btn-sm btn-primary';
      btn.textContent = '⚡ Challenge Mode: ON (3 Lives)';
      badge.innerHTML = `Lives: <span style="color:#ff4d6d;">💖 💖 💖</span>`;
    } else {
      btn.className = 'btn btn-sm btn-secondary';
      btn.textContent = '🌸 Chill Practice (No Lives)';
      badge.innerHTML = `Lives: <span style="color:#2b8a3e;">∞ Chill Mode</span>`;
    }
    startAsteroid();
  }

  function setAstroSpeed(s) {
    astroSpeed = s;
    document.getElementById('speedGentle').style.background = s === 'gentle' ? 'var(--pink-100)' : 'white';
    document.getElementById('speedNormal').style.background = s === 'normal' ? 'var(--pink-100)' : 'white';
  }

  function startAsteroid() {
    const cards = getActiveCards();
    if (!cards || cards.length < 2) {
      toast('Need at least 2 cards for Asteroid');
      return;
    }

    endAsteroid();
    currentCards = cards;
    astroScore = 0;
    astroLives = 3;
    astroActive = [];
    astroTargetIdx = -1;
    astroSeen = new Set();
    astroLast = null;

    document.getElementById('astroScore').textContent = '0';
    document.getElementById('astroActiveCount').textContent = '0';
    document.getElementById('astroLivesBadge').innerHTML = challengeMode
      ? `Lives: <span style="color:#ff4d6d;">💖 💖 💖</span>`
      : `Lives: <span style="color:#2b8a3e;">∞ Chill Mode</span>`;
    document.getElementById('asteroidArea').querySelectorAll('.asteroid').forEach(a => a.remove());
    document.getElementById('astroTarget').textContent = '';
    document.getElementById('astroOptions').innerHTML = '';
    showScreen('asteroid');

    spawnAsteroid();
    astroSpawnTimer = setInterval(spawnAsteroid, 2600);
    astroInterval = setInterval(moveAsteroids, 40);
  }

  // Weighted-random card: hard / new cards come up more, mastered ones rarely.
  // Never the same card twice on screen, and never twice in a row.
  function nextAstroCard() {
    let pool = currentCards.filter(c => !astroActive.some(a => a.card === c));
    if (!pool.length) pool = currentCards;
    if (pool.length > 1 && astroLast) {
      const alt = pool.filter(c => c !== astroLast);
      if (alt.length) pool = alt;
    }
    const card = weightedShuffle(pool, c => cardWeight(c) * (astroSeen.has(c) ? 1 : 3))[0];
    astroSeen.add(card);
    astroLast = card;
    return card;
  }

  function spawnAsteroid() {
    // USER REQUIREMENT: EXACTLY 2 AT A TIME MAX
    if (astroActive.length >= 2) return;
    const area = document.getElementById('asteroidArea');
    if (!area) return;

    const card = nextAstroCard();

    // USER REQUIREMENT: Dynamic circle sizing based on words and letters
    const { diameter, fontSize } = calculateAsteroidMetrics(card.term);

    const maxX = Math.max(12, area.clientWidth - diameter - 16);
    const x = Math.max(12, Math.floor(Math.random() * maxX));

    // USER REQUIREMENT: Gentle speed, not too fast
    const baseSpeed = astroSpeed === 'gentle' ? 0.35 : 0.55;
    const speed = baseSpeed + Math.random() * 0.18;

    const el = document.createElement('div');
    el.className = 'asteroid';
    el.style.width = diameter + 'px';
    el.style.height = diameter + 'px';
    el.style.left = x + 'px';
    el.style.top = -diameter + 'px';
    el.style.fontSize = fontSize;
    el.textContent = card.term;
    area.appendChild(el);

    const obj = { el, y: -diameter, speed, def: card.def, term: card.term, card, diameter, missed: false };
    el.onclick = () => selectAstroTarget(astroActive.indexOf(obj));
    astroActive.push(obj);
    document.getElementById('astroActiveCount').textContent = astroActive.length;

    if (astroTargetIdx < 0) selectAstroTarget(0);
  }

  function selectAstroTarget(i) {
    if (i < 0 || i >= astroActive.length) return;
    astroTargetIdx = i;

    astroActive.forEach((a, j) => {
      if (j === i) a.el.classList.add('target');
      else a.el.classList.remove('target');
    });

    const target = astroActive[i];
    document.getElementById('astroTarget').textContent = '🎯 Target: ' + target.term;

    const correct = target.def;
    const others = currentCards.filter(c => c.def !== correct).map(c => c.def);
    for (let k = others.length - 1; k > 0; k--) {
      const j = Math.floor(Math.random() * (k + 1));
      [others[k], others[j]] = [others[j], others[k]];
    }

    const opts = [correct, ...others.slice(0, 3)];
    for (let k = opts.length - 1; k > 0; k--) {
      const j = Math.floor(Math.random() * (k + 1));
      [opts[k], opts[j]] = [opts[j], opts[k]];
    }

    const box = document.getElementById('astroOptions');
    box.innerHTML = '';
    opts.forEach(o => {
      const btn = document.createElement('button');
      btn.className = 'btn btn-secondary cute-scrollbar';
      btn.style.cssText = 'font-size:0.84rem; padding:12px; text-align:left; line-height:1.3; max-height:85px; overflow-y:auto;';
      btn.textContent = o;
      btn.onclick = () => blastMC(o);
      box.appendChild(btn);
    });
  }

  function blastMC(chosen) {
    if (astroTargetIdx < 0 || astroTargetIdx >= astroActive.length) return;
    const a = astroActive[astroTargetIdx];

    if (chosen === a.def) {
      playCuteSuccess();
      if (!a.missed) recordAnswer(a.card, 'ok'); // only counts if there was no wrong guess first
      a.el.classList.add('hit');
      setTimeout(() => a.el.remove(), 350);
      astroActive.splice(astroTargetIdx, 1);
      astroScore += 10;
      document.getElementById('astroScore').textContent = astroScore;
      document.getElementById('astroActiveCount').textContent = astroActive.length;
      astroTargetIdx = -1;
      document.getElementById('astroTarget').textContent = '';
      document.getElementById('astroOptions').innerHTML = '';
      if (astroActive.length > 0) selectAstroTarget(0);
      else spawnAsteroid(); // nothing left on screen: bring the next one in right away
    } else {
      if (!a.missed) { a.missed = true; recordAnswer(a.card, 'miss'); }
      document.getElementById('astroOptions').style.animation = 'shake 0.4s';
      setTimeout(() => document.getElementById('astroOptions').style.animation = '', 400);
      toast('Try again! 💪');
    }
  }

  function moveAsteroids() {
    const area = document.getElementById('asteroidArea');
    if (!area) return;
    const maxY = area.clientHeight;

    for (let i = astroActive.length - 1; i >= 0; i--) {
      const a = astroActive[i];
      a.y += a.speed;
      a.el.style.top = a.y + 'px';

      if (a.y > maxY) {
        a.el.remove();
        if (!a.missed) { a.missed = true; recordAnswer(a.card, 'miss'); } // let it fall = didn't know it in time
        const wasTarget = i === astroTargetIdx;
        astroActive.splice(i, 1);
        document.getElementById('astroActiveCount').textContent = astroActive.length;

        if (wasTarget) {
          astroTargetIdx = -1;
          document.getElementById('astroTarget').textContent = '';
          document.getElementById('astroOptions').innerHTML = '';
          if (astroActive.length > 0) selectAstroTarget(0);
        } else if (astroTargetIdx > i) {
          astroTargetIdx--;
        }

        // USER REQUIREMENT: NO LIVES UNLESS CHALLENGE MODE ON
        if (challengeMode) {
          astroLives--;
          const heartsStr = '💖 '.repeat(Math.max(0, astroLives));
          document.getElementById('astroLivesBadge').innerHTML = `Lives: <span style="color:#ff4d6d;">${heartsStr || 'None'}</span>`;
          if (astroLives <= 0) {
            endAsteroid();
            showOverlay('💫', 'Game Over', `Score: ${astroScore}. Try again or chill out!`, [
              { text: 'Try Again 💖', primary: true, action: startAsteroid },
              { text: 'Switch to Chill Mode 🌸', primary: false, action: toggleChallengeMode }
            ]);
            return; // asteroid list was reset - stop looping over it
          }
        }

        if (astroActive.length === 0) spawnAsteroid(); // keep answer choices on screen
      }
    }
  }

  function endAsteroid() {
    if (astroInterval) clearInterval(astroInterval);
    if (astroSpawnTimer) clearInterval(astroSpawnTimer);
    astroInterval = null;
    astroSpawnTimer = null;
    astroActive = [];
    astroTargetIdx = -1;
  }

  // Floating background: scattered emojis + pure white twinkling glitter
  function createHearts() {
    const container = document.getElementById('hearts');
    container.innerHTML = '';

    // Soft scattered emojis (safe, widely-supported ones only)
    const emojis = [
      '💕', '💗', '🌸', '✨', '💖', '🎀', '⭐', '🌟', '💫',
      '🦋', '🌺', '🌷', '✨', '💖', '🌸', '💕', '⭐', '💗'
    ];
    for (let i = 0; i < 26; i++) {
      const h = document.createElement('div');
      const emoji = emojis[i % emojis.length];
      const isGlitter = emoji === '✨' || emoji === '⭐' || emoji === '🌟' || emoji === '💫' || Math.random() < 0.35;
      h.className = 'heart' + (isGlitter ? ' glitter' : '');
      h.textContent = emoji;

      // Bias more emojis toward the right side of the screen
      let left;
      if (Math.random() < 0.68) {
        left = 48 + Math.random() * 48; // 48–96% (right half bias)
      } else {
        left = 2 + Math.random() * 42;  // some on the left too
      }
      h.style.left = left + '%';
      h.style.top = (Math.random() * 90 + 4) + '%';

      const size = isGlitter ? (11 + Math.random() * 12) : (15 + Math.random() * 14);
      h.style.fontSize = size + 'px';
      h.style.opacity = (0.13 + Math.random() * 0.2).toFixed(2);
      const duration = 10 + Math.random() * 9;
      const delay = Math.random() * 7;
      if (isGlitter && Math.random() < 0.55) {
        h.style.animation = `sparkle ${3.8 + Math.random() * 4}s infinite ease-in-out`;
        h.style.animationDelay = delay + 's';
      } else {
        h.style.animationDuration = duration + 's';
        h.style.animationDelay = delay + 's';
      }
      container.appendChild(h);
    }

    // Pure white twinkling circle glitter only
    for (let i = 0; i < 55; i++) {
      const dot = document.createElement('div');
      dot.className = 'sparkle-dot';
      const size = 2 + Math.random() * 4.5; // small 2–6.5 px circles
      const color = 'rgba(255, 255, 255, 0.95)';
      dot.style.width = size + 'px';
      dot.style.height = size + 'px';
      // Spread glitter everywhere
      dot.style.left = (Math.random() * 98 + 1) + '%';
      dot.style.top = (Math.random() * 96 + 2) + '%';
      // Soft white glow
      const glow = Math.max(5, size * 2.4);
      dot.style.background = color;
      dot.style.boxShadow = `0 0 ${glow}px rgba(255,255,255,0.95), 0 0 ${glow * 2}px rgba(255,255,255,0.55)`;
      // Twinkle timing
      const dur = 1.6 + Math.random() * 3.4;
      const delay = Math.random() * 5;
      dot.style.animation = `glitterTwinkle ${dur}s infinite ease-in-out`;
      dot.style.animationDelay = delay + 's';
      container.appendChild(dot);
    }
  }

  createHearts();
  renderHome();

  // Keyboard shortcuts for Study
  window.addEventListener('keydown', (e) => {
    if (!document.getElementById('study').classList.contains('active')) return;
    if (document.getElementById('overlay').classList.contains('show')) return;
    if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); flipCard(); }
    if (e.key === 'ArrowRight') { e.preventDefault(); skipCard(); }
    if (studyFlipped) {
      if (e.key === '1') rateCard('again');
      if (e.key === '2') rateCard('ok');
    }
  });
</script>
